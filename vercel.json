{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm start",
  "builds": [
    {
      "src": "index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.ts"
    }
  ],
  "functions": {
    "index.ts": {
      "includeFiles": [
        "views/**",
        "public/**"
      ]
    }
  }
}