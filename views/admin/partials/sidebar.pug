aside#sidebar(class="fixed left-0 top-0 h-screen w-64 z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 bg-gradient-to-b from-indigo-950 to-indigo-900 overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:bg-white/10 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-white/20")
  //- Logo Area
  div(class="px-6 py-5 border-b border-white/10")
    a(href='/admin' class="flex items-center gap-3")
      img(src='/images/logo.svg' alt='Logo' class="h-8 w-8" onerror="this.src='https://cdn.iconscout.com/icon/free/png-256/music-1128-434479.png'")
      div
        div(class="text-xl font-bold text-white") MusicApp
        div(class="text-xs text-indigo-300 font-medium") Admin Panel

  //- Navigation Links
  nav(class="p-4 space-y-6")
    //- TỔNG QUAN
    div
      div(class="px-4 pt-2 pb-2 text-xs font-semibold text-indigo-400/70 uppercase tracking-wider") TỔNG QUAN
      div(class="space-y-1")
        a(href='/admin/dashboard' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-dashboard' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='layout-dashboard' class="w-5 h-5")
          | Dashboard

    //- QUẢN LÝ NỘI DUNG
    div
      div(class="px-4 pt-6 pb-2 text-xs font-semibold text-indigo-400/70 uppercase tracking-wider") QUẢN LÝ NỘI DUNG
      div(class="space-y-1")
        a(href='/admin/topics' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-topics' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='folder' class="w-5 h-5")
          | Chủ đề
        a(href='/admin/songs' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-songs' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='music' class="w-5 h-5")
          | Bài hát
        a(href='/admin/singers' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-singers' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='mic-2' class="w-5 h-5")
          | Ca sĩ

    //- QUẢN LÝ HỆ THỐNG
    div
      div(class="px-4 pt-6 pb-2 text-xs font-semibold text-indigo-400/70 uppercase tracking-wider") QUẢN LÝ HỆ THỐNG
      div(class="space-y-1")
        a(href='/admin/accounts' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-accounts' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='shield' class="w-5 h-5")
          | Tài khoản Admin
        a(href='/admin/users' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-users' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='users' class="w-5 h-5")
          | Người dùng
        a(href='/admin/roles' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-roles' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='key' class="w-5 h-5")
          | Phân quyền

    //- CÀI ĐẶT
    div
      div(class="px-4 pt-6 pb-2 text-xs font-semibold text-indigo-400/70 uppercase tracking-wider") CÀI ĐẶT
      div(class="space-y-1")
        a(href='/admin/settings' class=['flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all duration-200 text-sm', (locals.activeNav === 'admin-settings' ? 'bg-white/15 text-white font-medium' : 'text-indigo-200 hover:bg-white/10 hover:text-white')])
          i(data-lucide='settings' class="w-5 h-5")
          | Cài đặt chung