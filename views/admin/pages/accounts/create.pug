extends ../../layouts/admin
include ../../mixins/breadcrumb
include ../../mixins/form-controls
include ../../mixins/button

block pageTitle
  | #{pageTitle}
block breadcrumbItems
  +breadcrumb([
    {label: 'Trang chủ', url: '/admin/dashboard'},
    {label: 'Tài khoản', url: '/admin/accounts'},
    {label: 'Thêm mới', url: ''}
  ])

block adminContent
  div(class="mb-6")
    h1(class="text-2xl font-bold text-slate-900") Thêm tài khoản mới
    p(class="text-slate-500 mt-1 text-sm") Nhập thông tin để tạo tài khoản quản trị hệ thống

  div(class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 max-w-2xl")
    form(action="/admin/accounts/create" method="POST" enctype="multipart/form-data" class="validate-form space-y-6")
      +formInput({
        name: 'username',
        label: 'Tên đăng nhập',
        type: 'text',
        placeholder: 'Nhập tên đăng nhập...',
        required: true
      })

      +formInput({
        name: 'fullname',
        label: 'Họ và tên',
        type: 'text',
        placeholder: 'Nhập họ và tên...',
        required: true
      })
      
      +formInput({
        name: 'email',
        label: 'Email đăng nhập',
        type: 'email',
        placeholder: 'ví dụ: user@example.com',
      })
      
      +formInput({
        name: 'password',
        label: 'Mật khẩu',
        type: 'password',
        placeholder: 'Nhập mật khẩu (ít nhất 6 ký tự)',
        required: true
      })
      
      +formSelect({
        name: 'role_id',
        label: 'Vai trò',
        options: roles,
        required: true
      })
      
      +formFileUpload({
        name: 'avatar',
        label: 'Ảnh đại diện',
        accept: 'image/*',
        helpText: 'Tùy chọn. Kích thước tối đa 2MB.'
      })
      
      +formSelect({
        name: 'status',
        label: 'Trạng thái',
        options: [
          {value: 'active', text: 'Hoạt động'},
          {value: 'inactive', text: 'Khóa tài khoản'}
        ],
        selected: 'active'
      })
      
      div(class="pt-4 flex items-center gap-3 border-t border-slate-200")
        button(type="submit" class="bg-indigo-500 hover:bg-indigo-600 text-white font-medium rounded-lg px-4 py-2.5 text-sm shadow-sm inline-flex items-center gap-2 transition-colors")
          i(data-lucide="save").w-4.h-4
          | Tạo tài khoản
        a(href="/admin/accounts" class="border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-lg px-4 py-2.5 text-sm transition-colors") Hủy bỏ
