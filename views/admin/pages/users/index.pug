extends ../../layouts/admin
include ../../mixins/button
include ../../mixins/pagination
include ../../mixins/badge
include ../../mixins/filter-status
include ../../mixins/sort
include ../../mixins/change-multi
include ../../mixins/search-bar
include ../../mixins/breadcrumb
include ../../mixins/avatar

block pageTitle
  | #{pageTitle}

block breadcrumbItems
  +breadcrumb([
    {label: 'Trang chủ', url: '/admin/dashboard'},
    {label: 'Người dùng', url: '/admin/users'}
  ])

block adminContent
  div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6")
    div
      h1(class="text-2xl font-bold text-slate-900") Danh sách người dùng
      p(class="text-slate-500 mt-1 text-sm") Quản lý tài khoản người dùng ứng dụng

  div(class="bg-white rounded-xl shadow-sm border border-slate-200")
    div(class="p-4 border-b border-slate-200 flex flex-col xl:flex-row xl:items-center justify-between gap-4 bg-slate-50/50 rounded-t-xl")
      +filterStatus(filterStatus)
      div(class="flex flex-wrap items-center gap-3 w-full xl:w-auto justify-end")
        +boxChange("/admin/users/change-multi?_method=PATCH", "user")
        +boxSort()
        div(class="w-full sm:w-auto sm:max-w-xs")
          +searchBar('Tìm kiếm người dùng...', '', '')
        
    div(class="overflow-x-auto")
      table(class="w-full text-left border-collapse min-w-[800px]")
        thead
          tr
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50") Người dùng
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50") Ngày đăng ký
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50") Trạng thái
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-right") Hành động
        tbody
          each user in users
            tr(class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors")
              td(class="px-6 py-4")
                div(class="flex items-center gap-3")
                  +avatar(user.avatar, user.name, 'md')
                  div(class="flex flex-col")
                    span(class="font-medium text-slate-900")= user.name
                    span(class="text-sm text-slate-500")= user.email
              td(class="px-6 py-4 text-sm text-slate-500")= user.createdAt
              td(class="px-6 py-4")
                if user.status === 'active'
                  +badge('Hoạt động', 'success')
                else if user.status === 'banned'
                  +badge('Bị khóa', 'danger')
                else
                  +badge('Chưa xác thực', 'warning')
              td(class="px-6 py-4 text-right")
                a(href=`/admin/users/detail/${user.id}` class="inline-flex items-center gap-1.5 p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors text-sm font-medium")
                  i(data-lucide="eye").w-4.h-4
                  | Chi tiết
    div(class="p-4 border-t border-slate-200 flex items-center justify-between rounded-b-xl")
      span(class="text-sm text-slate-500") Tổng số người dùng: #{countData}
      +pagination(objectPagination)

