extends ../../layouts/admin
include ../../mixins/breadcrumb
include ../../mixins/form-controls
include ../../mixins/button

block pageTitle
  title Thêm nhóm quyền | Admin

block breadcrumbItems
  +breadcrumb([
    {label: 'Trang chủ', url: '/admin/dashboard'},
    {label: 'Nhóm quyền', url: '/admin/roles'},
    {label: 'Thêm mới', url: ''}
  ])

block adminContent
  div(class="mb-6")
    h1(class="text-2xl font-bold text-slate-900") Thêm nhóm quyền mới
    p(class="text-slate-500 mt-1 text-sm") Nhập thông tin để tạo nhóm quyền mới

  div(class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 max-w-2xl")
    form(action="/admin/roles/create" method="POST" class="validate-form space-y-6")
      
      +formInput({
        name: 'title',
        label: 'Tên nhóm quyền',
        type: 'text',
        placeholder: 'Nhập tên nhóm quyền...',
        required: true
      })
      
      +formTextarea({
        name: 'description',
        label: 'Mô tả',
        placeholder: 'Nhập mô tả cho nhóm quyền này...',
        rows: 4
      })
      
      div(class="pt-4 flex items-center gap-3 border-t border-slate-200")
        button(type="submit" class="bg-indigo-500 hover:bg-indigo-600 text-white font-medium rounded-lg px-4 py-2.5 text-sm shadow-sm inline-flex items-center gap-2 transition-colors")
          i(data-lucide="save").w-4.h-4
          | Lưu lại
        a(href="/admin/roles" class="border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-lg px-4 py-2.5 text-sm transition-colors") Hủy bỏ
