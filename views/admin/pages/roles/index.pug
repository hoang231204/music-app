extends ../../layouts/admin
include ../../mixins/breadcrumb
include ../../mixins/button
include ../../mixins/modal

block pageTitle
  | #{pageTitle}

block breadcrumbItems
  +breadcrumb([
    {label: 'Trang chủ', url: '/admin/dashboard'},
    {label: 'Nhóm quyền', url: '/admin/roles'}
  ])

block adminContent
  div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6")
    div
      h1(class="text-2xl font-bold text-slate-900") Quản lý nhóm quyền
      p(class="text-slate-500 mt-1 text-sm") Phân quyền chi tiết cho các tài khoản quản trị
    div(class="flex items-center gap-3")
      a(href="/admin/roles/create" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg px-4 py-2.5 text-sm shadow-sm transition-colors")
        i(data-lucide="plus" class="w-4 h-4")
        | Thêm quyền
      a(href="/admin/roles/permissions" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg px-4 py-2.5 text-sm shadow-sm transition-colors")
        i(data-lucide="settings" class="w-4 h-4")
        | Phân quyền

  div(class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden")
    div(class="overflow-x-auto")
      table(class="w-full text-left border-collapse min-w-[700px]")
        thead
          tr
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50") Tên nhóm quyền
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50") Mô tả
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-center") Số quyền
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-center") Số tài khoản
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-right") Hành động
        tbody
          if(roles && roles.length > 0)
            each role in roles
              tr(class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors")
                td(class="px-6 py-4 font-medium text-slate-900")= role.title
                td(class="px-6 py-4 text-sm text-slate-600")= role.description
                td(class="px-6 py-4 text-sm text-slate-700 text-center")
                  span(class="inline-flex items-center justify-center bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full text-xs font-medium")= role.countPermissions
                td(class="px-6 py-4 text-sm text-slate-700 text-center")= role.countAccounts
                td(class="px-6 py-4 text-right")
                  div(class="flex items-center justify-end gap-2")
                    a(href=`/admin/roles/edit/${role.id}` class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Sửa")
                      i(data-lucide="edit" class="w-4 h-4")
                    button(type="button" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Xóa" data-delete-url=`/admin/roles/delete/${role.id}`)
                      i(data-lucide="trash-2" class="w-4 h-4")
  +modal({
    id: 'delete-confirm',
    title: 'Xóa nhóm quyền',
    body: 'Bạn có chắc chắn muốn xóa nhóm quyền này không? Hành động này không thể hoàn tác.',
    cancelLabel: 'Hủy'
  })
    form(id="delete-form" method="POST" action="")
      input(type="hidden" name="_method" value="DELETE")
      button(type="submit" class="px-4 py-2 rounded-lg font-medium transition-colors bg-red-500 hover:bg-red-600 text-white") Xác nhận