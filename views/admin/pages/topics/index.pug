extends ../../layouts/admin
include ../../mixins/button
include ../../mixins/pagination
include ../../mixins/modal
include ../../mixins/badge
include ../../mixins/search-bar
include ../../mixins/breadcrumb
include ../../mixins/filter-status
include ../../mixins/sort
include ../../mixins/change-multi

block pageTitle
  | #{pageTitle}

block breadcrumbItems
  +breadcrumb([
    {label: 'Trang chủ', url: '/admin/dashboard'},
    {label: 'Chủ đề', url: '/admin/topics'}
  ])

block adminContent
  div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6")
    div
      h1(class="text-2xl font-bold text-slate-900") Quản lý chủ đề
      p(class="text-slate-500 mt-1 text-sm") Xem, thêm, sửa, xóa các chủ đề bài hát
    div(class="flex items-center gap-3")
      a(href="/admin/topics/create" class="inline-flex items-center gap-2 bg-indigo-500 hover:bg-indigo-600 text-white font-medium rounded-lg px-4 py-2.5 text-sm shadow-sm transition-colors")
        i(data-lucide="plus" class="w-4 h-4")
        | Thêm mới

  div(class="bg-white rounded-xl shadow-sm border border-slate-200")
    div(class="p-4 border-b border-slate-200 flex flex-col xl:flex-row xl:items-center justify-between gap-4 bg-slate-50/50 rounded-t-xl")
      +filterStatus(filterStatus)
      div(class="flex flex-wrap items-center gap-3 w-full xl:w-auto justify-end")
        +boxChange("/admin/topics/change-multi?_method=PATCH", "topic")
        +boxSort()
        div(class="w-full sm:w-auto sm:max-w-xs")
          +searchBar('Tìm kiếm chủ đề...', '', '')
        
    div(class="overflow-x-auto")
      table(class="w-full text-left border-collapse min-w-[800px]")
        thead
          tr
            th(class="w-12 px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50")
              input(type="checkbox" class="rounded border-slate-300 text-indigo-500 focus:ring-indigo-500" checkbox-all)
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 w-24") Ảnh
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 ") Tên chủ đề
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 ") Mô tả
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 ") Số bài
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 ") Trạng thái
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-center") Ngày tạo
            th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 text-center") Hành động
        tbody
          each topic in topics
            tr(class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors")
              td(class="px-6 py-4")
                input(type="checkbox" class="rounded border-slate-300 text-indigo-500 focus:ring-indigo-500" checkbox-item value=topic.id)
              td(class="px-6 py-4")
                img(src=topic.avatar alt=topic.title class="w-12 h-12 rounded-lg object-cover border border-slate-200")
              td(class="px-6 py-4 font-medium text-slate-900")= topic.title
              
              td(class="px-6 py-4 text-sm text-slate-500 max-w-[200px] relative group cursor-pointer")
                span(class="block truncate")= topic.description
                div(class="absolute left-1/2 -translate-x-1/2 top-full mt-1 hidden group-hover:block z-50 w-max max-w-xs p-2.5 bg-slate-900 text-white text-xs rounded-lg shadow-xl whitespace-normal break-words pointer-events-none")
                  | #{topic.description}

              td(class="px-6 py-4 text-sm text-slate-700")= topic.songCount
              td(class="px-6 py-4")
                if topic.status === 'active'
                  +badge('Hoạt động', 'success')
                else
                  +badge('Dừng', 'danger')
              td(class="px-6 py-4 text-sm text-slate-500")= topic.createdAt
              td(class="px-6 py-4 text-right")
                div(class="flex items-center justify-end gap-2")
                  a(href=`/admin/topics/edit/${topic.id}` class="p-1.5 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Sửa")
                    i(data-lucide="edit" class="w-4 h-4")
                  button(type="button" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Xóa" data-delete-url=`/admin/topics/delete/${topic.id}`)
                    i(data-lucide="trash-2" class="w-4 h-4")

    div(class="p-4 border-t border-slate-200 flex items-center justify-between rounded-b-xl")
      span(class="text-sm text-slate-500") Tổng số chủ đề: #{countData}
      +pagination(objectPagination)

  +modal({
    id: 'delete-confirm',
    title: 'Xóa chủ đề',
    body: 'Bạn có chắc chắn muốn xóa chủ đề này không? Hành động này không thể hoàn tác.',
    cancelLabel: 'Hủy'
  })
    form(id="delete-form" method="POST" action="")
      input(type="hidden" name="_method" value="DELETE")
      button(type="submit" class="px-4 py-2 rounded-lg font-medium transition-colors bg-red-500 hover:bg-red-600 text-white") Xác nhận