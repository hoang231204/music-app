mixin btn(label, variant = 'primary', size = 'md', icon = null, type = 'button')
  - 
    var baseClasses = "inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
    var sizeClasses = {
      'sm': 'px-3 py-1.5 text-xs',
      'md': 'px-4 py-2.5 text-sm',
      'lg': 'px-6 py-3 text-base'
    }
    var variantClasses = {
      'primary': 'bg-indigo-500 hover:bg-indigo-600 text-white shadow-sm focus:ring-indigo-500',
      'secondary': 'bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-white/10 dark:hover:bg-white/20 dark:text-white focus:ring-slate-500',
      'outline': 'border border-slate-300 hover:bg-slate-50 text-slate-700 dark:border-white/20 dark:text-white dark:hover:bg-white/10 focus:ring-slate-500',
      'danger': 'bg-red-500 hover:bg-red-600 text-white focus:ring-red-500',
      'ghost': 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white dark:hover:bg-white/10 focus:ring-slate-500'
    }
    var classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]}`
    
  button(type=type class=classes)&attributes(attributes)
    if icon
      - var iconSize = size === 'sm' ? 'w-3 h-3' : (size === 'lg' ? 'w-5 h-5' : 'w-4 h-4')
      i(data-lucide=icon class=iconSize)
    if label
      span= label
