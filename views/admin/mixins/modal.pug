mixin modal(config)
  - var confirmVariantClasses = config.confirmVariant === 'danger' ? 'bg-red-500 hover:bg-red-600 text-white' : 'bg-indigo-500 hover:bg-indigo-600 text-white'
  div(id=config.id class="fixed inset-0 z-50 hidden flex items-center justify-center")
    div(data-modal-close class="absolute inset-0 bg-black/70 pointer-events-auto")
    div(class="relative bg-white text-slate-900 rounded-2xl shadow-2xl w-full max-w-md mx-4 p-6 antialiased pointer-events-auto z-10")
      div(class="flex items-center justify-between mb-4")
        h3(class="text-xl font-bold text-slate-900")= config.title
        button(type="button" data-modal-close class="text-slate-400 hover:text-slate-600 transition-colors")
          i(data-lucide="x" class="w-5 h-5")
      div(class="text-slate-600 mb-6")
        | !{config.body}
      div(class="flex justify-end gap-3")
        button(type="button" data-modal-close class="px-4 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50 font-medium transition-colors")= config.cancelLabel || 'Hủy'
        if block
          block
        else
          button(type="button" class=['px-4 py-2 rounded-lg font-medium transition-colors', confirmVariantClasses])= config.confirmLabel || 'Xác nhận'