mixin modal(config)
  - var confirmVariantClasses = config.confirmVariant === 'danger' ? 'bg-red-500 hover:bg-red-600 text-white' : 'bg-indigo-500 hover:bg-indigo-600 text-white'
  div(id=`modal-${config.id}` class="fixed inset-0 z-50 hidden flex items-center justify-center")
    div(data-modal-close class="absolute inset-0 bg-black/60 backdrop-blur-sm")
    div(class="relative bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-md mx-4 p-6 animate-bounceIn")
      div(class="flex items-center justify-between mb-4")
        h3(class="text-xl font-bold text-slate-900 dark:text-white")= config.title
        button(data-modal-close class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors")
          i(data-lucide="x" class="w-5 h-5")
      div(class="text-slate-600 dark:text-slate-300 mb-6")
        | !{config.body}
      div(class="flex justify-end gap-3")
        button(data-modal-close class="px-4 py-2 border border-slate-300 dark:border-white/20 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 font-medium transition-colors")= config.cancelLabel || 'Hủy'
        if block
          block
        else
          button(class=['px-4 py-2 rounded-lg font-medium transition-colors', confirmVariantClasses])= config.confirmLabel || 'Xác nhận'