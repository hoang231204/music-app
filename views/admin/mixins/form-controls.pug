//- Form control mixins: formInput, formSelect, formTextarea, formCheckbox, formFileUpload
mixin formInput(config)
  - var { name, label, type = 'text', placeholder = '', value = '', error = null, required = false, disabled = false, helpText = null } = config
  div(class="w-full")
    if label
      label(class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for=name)
        | #{label}
        if required
          span(class="text-red-500 ml-1") *
    input(
      type=type
      id=name
      name=name
      placeholder=placeholder
      value=value
      required=required
      disabled=disabled
      class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all dark:bg-white/5 dark:border-white/10 dark:text-white dark:placeholder-white/40" + (error ? " border-red-500 focus:border-red-500 focus:ring-red-500/20" : "")
    )&attributes(attributes)
    if error
      p(class="text-red-500 text-xs mt-1")= error
    else if helpText
      p(class="text-slate-500 dark:text-slate-400 text-xs mt-1")= helpText

mixin formSelect(config)
  - var { name, label, options = [], selected = '', error = null, required = false, disabled = false, placeholder = '-- Chọn --' } = config
  div(class="w-full")
    if label
      label(class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for=name)
        | #{label}
        if required
          span(class="text-red-500 ml-1") *
    select(
      id=name
      name=name
      required=required
      disabled=disabled
      class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all dark:bg-slate-800 dark:border-white/10 dark:text-white" + (error ? " border-red-500 focus:border-red-500 focus:ring-red-500/20" : "")
    )&attributes(attributes)
      if placeholder
        option(value="" disabled selected=(!selected))= placeholder
      each opt in options
        option(
          value=(opt.value || opt._id || '') 
          selected=((opt.value || opt._id || '').toString() === selected.toString())
        )= opt.text || opt.fullname || opt.title || ''
    if error
      p(class="text-red-500 text-xs mt-1")= error

mixin formTextarea(config)
  - var { name, label, placeholder = '', value = '', rows = 4, error = null, required = false, disabled = false } = config
  div(class="w-full")
    if label
      label(class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for=name)
        | #{label}
        if required
          span(class="text-red-500 ml-1") *
    textarea(
      id=name
      name=name
      rows=rows
      placeholder=placeholder
      required=required
      disabled=disabled
      class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all dark:bg-white/5 dark:border-white/10 dark:text-white dark:placeholder-white/40" + (error ? " border-red-500 focus:border-red-500 focus:ring-red-500/20" : "")
    )&attributes(attributes)= value
    if error
      p(class="text-red-500 text-xs mt-1")= error

mixin formCheckbox(config)
  - var { name, label, checked = false, disabled = false, value = 'true' } = config
  label(class="flex items-center gap-2 cursor-pointer")
    input(
      type="checkbox"
      name=name
      value=value
      checked=checked
      disabled=disabled
      class="w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 focus:ring-2 dark:border-white/20 dark:bg-white/10 dark:checked:bg-indigo-500"
    )&attributes(attributes)
    if label
      span(class="text-sm font-medium text-slate-700 dark:text-slate-300")= label

mixin formFileUpload(config)
  - var { name, label, accept = "image/*", value = "", previewUrl = null, helpText = "Click to upload or drag and drop", error = null, required = false, type = "image" } = config
  div(class="w-full" upload-image)
    if label
      label(class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for=name)
        | #{label}
        if required
          span(class="text-red-500 ml-1") *
    div(class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-lg hover:border-indigo-500 transition-colors dark:border-white/20 dark:hover:border-indigo-400 relative")
      div(class="space-y-1 text-center")
        i(data-lucide="upload-cloud" class="mx-auto h-12 w-12 text-slate-400")
        div(class="flex text-sm text-slate-600 dark:text-slate-300 justify-center")
          label(for=name class="relative cursor-pointer bg-transparent rounded-md font-medium text-indigo-600 hover:text-indigo-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300")
            span= "Upload a file"
            input(
              id=name 
              name=name 
              type="file" 
              accept=accept 
              class="sr-only" 
              upload-image-input
            )&attributes(attributes)
          p(class="pl-1")= "or drag and drop"
        p(class="text-xs text-slate-500 dark:text-slate-400")= helpText
      div(class=`box-image absolute inset-0 bg-white dark:bg-slate-900 rounded-lg p-2 flex items-center justify-center ${!(previewUrl || value) ? 'hidden' : ''}`)
        if(type === "audio")
          audio(controls class="w-full h-12" upload-audio-preview)
            source(src=(previewUrl || value) type="audio/mpeg")
        else
            img(src=(previewUrl || value) upload-image-preview class="image-preview max-h-full rounded-md object-contain")
        button(type="button" class="btn-remove-image absolute top-2 right-2 p-1 bg-red-500 text-white rounded-full hover:bg-red-600 focus:outline-none") ×
    if error
      p(class="text-red-500 text-xs mt-1")= error