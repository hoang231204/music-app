extends ../../layouts/client
include ../../mixins/card-song
include ../../mixins/tabs

block pageTitle
  | #{pageTitle}

block clientContent
  - var tabItems = [{id: 'lyrics', label: 'Lời Bài Hát'}, {id: 'info', label: 'Thông Tin'}]
  div(class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 lg:pt-20 pb-16")
    div(class="flex flex-col lg:flex-row items-start gap-12 lg:gap-16") 
      //- Left: Cover Image
      div(class="w-full lg:w-1/3 max-w-md mx-auto lg:mx-0")
        div(class="relative group aspect-square rounded-2xl overflow-hidden shadow-2xl shadow-indigo-500/20")
          img(src=song.avatar alt=song.title class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105")
          div(class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center")
            button(onclick=`window.playSong(${JSON.stringify(song)})` class="bg-indigo-500 hover:bg-indigo-600 text-white rounded-full p-6 shadow-lg shadow-indigo-500/50 transform scale-75 group-hover:scale-100 transition-all duration-300")
              i(data-lucide="play" class="w-10 h-10 fill-current")
              
      //- Right: Info
      div(class="w-full lg:w-2/3 flex flex-col justify-center")
        div(class="flex items-center gap-3 mb-4")
          a(href=`/topics/${song.topicSlug}` class="bg-white/10 hover:bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full transition-colors")= song.topic
          span(class="text-slate-400 text-sm")= song.date
          
        h1(class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4")= song.title
        a(href=`/singers/${song.singerSlug}` class="text-xl text-indigo-400 hover:text-indigo-300 font-medium mb-8 inline-block transition-colors")= song.singer
        
        div(class="flex items-center gap-6 text-slate-300 mb-10")
          div(class="flex items-center gap-2")
            i(data-lucide="headphones" class="w-5 h-5")
            span #{(song.listen || 0).toLocaleString()} lượt nghe
          div(class="flex items-center gap-2")
            i(data-lucide="heart" class="w-5 h-5")
            span(data-song-likes=song._id.toString()) #{(song.like || 0).toLocaleString()} lượt thích
                    
        div(class="flex flex-wrap items-center gap-4")
          button(onclick=`window.playSong(${JSON.stringify(song)})` class="bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl px-8 py-4 shadow-lg shadow-indigo-500/25 transition-all duration-300 inline-flex items-center gap-2")
            i(data-lucide="play" class="w-5 h-5 fill-current")
            | Phát bài hát
            
          - var isFavorite = song.isFavorite || ((locals.favoriteSongIds || []).indexOf(song._id.toString()) !== -1)
          button(type="button" data-favorite-song=song._id.toString() aria-pressed=isFavorite title="Yêu thích bài hát" class="bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white rounded-xl p-4 backdrop-blur-sm transition-all shadow-sm")
            i(data-lucide="heart" class=isFavorite ? 'text-red-500 fill-red-500 w-6 h-6' : 'w-6 h-6')
            
          button(class="bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white rounded-xl p-4 backdrop-blur-sm transition-all shadow-sm")
            i(data-lucide="share-2" class="w-6 h-6")
            
          button(class="bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white rounded-xl p-4 backdrop-blur-sm transition-all shadow-sm")
            i(data-lucide="plus" class="w-6 h-6")

    //- Tabs for Lyrics and Info
    div(class="max-w-4xl mb-16 mt-12")
      +tabs(tabItems, 'lyrics')
      div(class="mt-8")
        #content-lyrics.tab-content
          div(class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8")
            pre(class="whitespace-pre-wrap text-slate-300 font-sans text-lg leading-relaxed")= song.lyrics
            
        #content-info.tab-content.hidden
          div(class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8")
            h3(class="text-xl font-semibold text-white mb-4") Về bài hát này
            p(class="text-slate-300 leading-relaxed mb-6")= song.description
            
            div(class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 pt-8 border-t border-white/10")
              div
                span(class="block text-slate-400 text-sm mb-1") Ca sĩ thể hiện
                a(href=`/singers/${song.singerSlug}` class="text-white font-medium hover:text-indigo-400")= song.singer_id.fullname
              div
                span(class="block text-slate-400 text-sm mb-1") Thể loại
                a(href=`/topics/${song.topicSlug}` class="text-white font-medium hover:text-indigo-400")= song.topic_id.title
              div
                span(class="block text-slate-400 text-sm mb-1") Ngày phát hành
                span(class="text-white font-medium")= song.createdAt

    Related Songs
      div
        div(class="flex items-center justify-between mb-8")
          h2(class="text-2xl sm:text-3xl font-bold text-white") Bài Hát Liên Quan
        div(class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6")
          each s in relatedSongs
            +cardSong(s)

block clientScripts
  script.
    // Basic tab logic
    document.querySelectorAll('[data-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all buttons
        document.querySelectorAll('[data-tab]').forEach(b => {
          b.classList.remove('border-indigo-500', 'text-indigo-400');
          b.classList.add('border-transparent', 'text-slate-400', 'hover:text-slate-300', 'hover:border-slate-300');
        });
        
        // Add active class to clicked button
        btn.classList.remove('border-transparent', 'text-slate-400', 'hover:text-slate-300', 'hover:border-slate-300');
        btn.classList.add('border-indigo-500', 'text-indigo-400');
        
        // Hide all contents
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        
        // Show target content
        const target = btn.getAttribute('data-tab');
        document.getElementById(`content-${target}`).classList.remove('hidden');
      });
    });