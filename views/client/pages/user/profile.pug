extends ../../layouts/client
include ../../mixins/card-song

block pageTitle
  | #{pageTitle}

block clientContent
  - var user = {name: 'Nguyễn Văn A', email: 'nguyenvana@example.com', avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=1480&auto=format&fit=crop', joinDate: 'Tham gia tháng 10, 2023', totalFavorites: 42, totalPlayed: 156}
  - var recentFavorites = [{title: 'Đêm Nay Mưa Rơi', cover: 'https://images.unsplash.com/photo-1518609878373-06d740f60d8b?q=80&w=1470&auto=format&fit=crop', singer: 'Hà Anh Tuấn', slug: 'dem-nay-mua-roi', likes: 1200, isFavorite: true, audio: '/audio/sample1.mp3'}, {title: 'Em Gái Mưa', cover: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1470&auto=format&fit=crop', singer: 'Hương Tràm', slug: 'em-gai-mua', likes: 3200, isFavorite: true, audio: '/audio/sample4.mp3'}, {title: 'Chạy Ngay Đi', cover: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?q=80&w=1374&auto=format&fit=crop', singer: 'Sơn Tùng M-TP', slug: 'chay-ngay-di', likes: 4200, isFavorite: true, audio: '/audio/sample6.mp3'}, {title: 'Cô Gái m52', cover: 'https://images.unsplash.com/photo-1459749411175-04bf5292ceea?q=80&w=1470&auto=format&fit=crop', singer: 'HuyR', slug: 'co-gai-m52', likes: 1100, isFavorite: true, audio: '/audio/sample10.mp3'}]

  section.max-w-7xl.mx-auto.px-4.sm\:px-6.lg\:px-8.py-12
    .flex.flex-col.lg\:flex-row.gap-10
      //- Left Sidebar (Profile Info)
      .w-full.lg\:w-1\/3
        .bg-white\/5.backdrop-blur-sm.border.border-white\/10.rounded-2xl.p-8.text-center
          .relative.w-32.h-32.mx-auto.mb-6
            img(src=user.avatar alt=user.name class="w-full h-full object-cover rounded-full border-4 border-indigo-500/30")
            button.absolute.bottom-0.right-0.bg-indigo-500.hover\:bg-indigo-600.text-white.p-2.rounded-full.transition-colors.shadow-lg
              i(data-lucide="camera").w-4.h-4
          
          h1.text-2xl.font-bold.text-white.mb-1= user.name
          p.text-slate-400.mb-4= user.email
          span.inline-block.bg-white\/10.text-slate-300.text-xs.px-3.py-1.rounded-full.mb-8= user.joinDate
          
          .grid.grid-cols-2.gap-4.border-t.border-white\/10.pt-8
            div
              span.block.text-2xl.font-bold.text-white= user.totalFavorites
              span.text-slate-400.text-sm Yêu thích
            div
              span.block.text-2xl.font-bold.text-white= user.totalPlayed
              span.text-slate-400.text-sm Đã nghe
              
        .mt-6
          button(class="w-full bg-white/5 hover:bg-white/10 border border-white/10 text-rose-500 hover:text-rose-400 font-medium rounded-xl px-6 py-3 transition-colors inline-flex items-center justify-center gap-2")
            i(data-lucide="log-out").w-5.h-5
            | Đăng xuất
              
      //- Right Content (Edit Form & Recents)
      .w-full.lg\:w-2\/3
        .bg-white\/5.backdrop-blur-sm.border.border-white\/10.rounded-2xl.p-6.sm\:p-8.mb-8
          h2.text-xl.font-bold.text-white.mb-6 Cập Nhật Thông Tin
          
          form(action="/profile/update" method="POST" class="space-y-6")
            .grid.grid-cols-1.sm\:grid-cols-2.gap-6
              div
                label(for="name" class="block text-sm font-medium text-slate-300 mb-2") Họ và tên
                input(type="text" name="name" id="name" value=user.name class="block w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 transition-all")
              div
                label(for="email" class="block text-sm font-medium text-slate-300 mb-2") Email
                input(type="email" name="email" id="email" value=user.email readonly class="block w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-slate-400 cursor-not-allowed")
                
            .border-t.border-white\/10.pt-6
              h3.text-lg.font-medium.text-white.mb-4 Đổi mật khẩu
              .grid.grid-cols-1.sm\:grid-cols-2.gap-6
                div
                  label(for="current-password" class="block text-sm font-medium text-slate-300 mb-2") Mật khẩu hiện tại
                  input(type="password" name="current_password" id="current-password" class="block w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 transition-all")
                div
                  label(for="new-password" class="block text-sm font-medium text-slate-300 mb-2") Mật khẩu mới
                  input(type="password" name="new_password" id="new-password" class="block w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 transition-all")
                  
            .flex.justify-end.pt-4
              button(type="submit" class="bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl px-8 py-3 shadow-lg shadow-indigo-500/25 transition-all duration-300") Lưu thay đổi
              
        .bg-white\/5.backdrop-blur-sm.border.border-white\/10.rounded-2xl.p-6.sm\:p-8
          .flex.items-center.justify-between.mb-6
            h2.text-xl.font-bold.text-white Bài Hát Yêu Thích Gần Đây
            a(href="/favorites" class="text-sm font-medium text-indigo-400 hover:text-indigo-300 transition-colors") Xem tất cả
          
          .grid.grid-cols-2.sm\:grid-cols-4.gap-4
            each song in recentFavorites
              +cardSong(song)
