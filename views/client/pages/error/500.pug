extends ../layouts/client

block pageTitle
  title Lỗi Hệ Thống | Music App

block clientContent
  section.relative.min-h-\[70vh\].flex.flex-col.items-center.justify-center.py-12.px-4.text-center
    .relative.z-10.max-w-md.mx-auto
      .mb-8.text-rose-500.flex.justify-center
        i(data-lucide="alert-triangle").w-24.h-24.animate-pulse
      h1.text-3xl.sm\:text-4xl.font-bold.text-white.mb-4 Đã xảy ra lỗi
      p.text-slate-400.mb-10 Rất tiếc, hệ thống đang gặp sự cố. Vui lòng thử lại sau ít phút.
      
      .flex.flex-col.sm\:flex-row.items-center.justify-center.gap-4
        button(onclick="window.location.reload()" class="w-full sm:w-auto bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-xl px-8 py-3 shadow-lg shadow-indigo-500/25 transition-all inline-flex items-center justify-center gap-2")
          i(data-lucide="refresh-cw").w-5.h-5
          | Thử lại
        a(href="/" class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl px-8 py-3 backdrop-blur-sm transition-all inline-flex items-center justify-center gap-2")
          i(data-lucide="home").w-5.h-5
          | Về trang chủ
