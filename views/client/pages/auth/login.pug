extends ../../layouts/client

block pageTitle
  | #{pageTitle}

block clientContent
  //- Hide player on this page if possible
  section(class="relative min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 overflow-hidden")
    //- Background animated shapes
    div(class="absolute inset-0 z-0")
      div(class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full mix-blend-screen filter blur-3xl animate-blob")
      div(class="absolute top-1/3 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full mix-blend-screen filter blur-3xl animate-blob animation-delay-2000")
      div(class="absolute -bottom-32 left-1/3 w-96 h-96 bg-pink-600/20 rounded-full mix-blend-screen filter blur-3xl animate-blob animation-delay-4000")
      
    div(class="relative z-10 w-full max-w-md")
      div(class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden")
        div(class="p-8 sm:p-10")
          div(class="text-center mb-8")
            div(class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 mb-4 shadow-lg")
              i(data-lucide="music" class="w-6 h-6 text-white")
            h2(class="text-2xl sm:text-3xl font-bold text-white") Chào Mừng Trở Lại
            p(class="text-slate-400 mt-2") Đăng nhập để tiếp tục thưởng thức âm nhạc
            
          form(action="/auth/login" method="POST" class="space-y-6")
            div
              label(for="username" class="block text-sm font-medium text-slate-300 mb-2") Tên đăng nhập
              div(class="relative")
                div(class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none")
                  i(data-lucide="user" class="w-5 h-5 text-slate-500")
                input(type="text" name="username" id="username" required placeholder="Nhập tên đăng nhập" class="block w-full pl-10 pr-3 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 transition-all")
                
            div
              div(class="flex items-center justify-between mb-2")
                label(for="password" class="block text-sm font-medium text-slate-300") Mật khẩu
                a(href="/auth/forgot-password" class="text-sm font-medium text-indigo-400 hover:text-indigo-300 transition-colors") Quên mật khẩu?
              div(class="relative")
                div(class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none")
                  i(data-lucide="lock" class="w-5 h-5 text-slate-500")
                input(type="password" name="password" id="password" required placeholder="Nhập mật khẩu" class="block w-full pl-10 pr-10 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/50 transition-all")
                button(type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-500 hover:text-slate-300 focus:outline-none")
                  i(data-lucide="eye" class="w-5 h-5")
            button(type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-indigo-500/25 text-sm font-semibold text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 focus:ring-indigo-500 transition-all duration-300") Đăng Nhập
            
          div(class="mt-6")
            div(class="relative")
              div(class="absolute inset-0 flex items-center")
                div(class="w-full border-t border-white/10")
              div(class="relative flex justify-center text-sm")
                span(class="px-2 bg-[#0f172a] text-slate-400 bg-opacity-50") Hoặc tiếp tục với
                
            div(class="mt-6 grid grid-cols-2 gap-4")
              button(type="button" class="w-full flex justify-center py-2.5 px-4 border border-white/10 rounded-xl shadow-sm bg-white/5 text-sm font-medium text-white hover:bg-white/10 transition-colors backdrop-blur-sm")
                span(class="sr-only") Đăng nhập với Google
                img(src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google")
                
              button(type="button" class="w-full flex justify-center py-2.5 px-4 border border-white/10 rounded-xl shadow-sm bg-white/5 text-sm font-medium text-white hover:bg-white/10 transition-colors backdrop-blur-sm")
                span(class="sr-only") Đăng nhập với Facebook
                img(src="https://www.svgrepo.com/show/475647/facebook-color.svg" class="w-5 h-5" alt="Facebook")
                
        div(class="px-8 py-6 bg-white/5 border-t border-white/10 text-center")
          p(class="text-sm text-slate-400") Chưa có tài khoản? 
            a(href="/auth/register" class="font-medium text-indigo-400 hover:text-indigo-300 transition-colors") Đăng ký ngay