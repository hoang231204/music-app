mixin pagination(objectPagination)
  if objectPagination.totalPages > 0
    nav(class="flex items-center gap-1.5" aria-label="Pagination")
      if objectPagination.currentPage > 1
        button(
          class="page-link inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition-colors shadow-sm"
          button-page=(objectPagination.currentPage - 1)
          type="button"
          title="Trang trước"
        )
          i(data-lucide="chevron-left" class="w-4 h-4")
          span(class="hidden sm:inline") Trang trước
      else
        button(
          class="page-link inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-300 bg-slate-50 border border-slate-200 rounded-lg cursor-not-allowed"
          disabled
          type="button"
        )
          i(data-lucide="chevron-left" class="w-4 h-4")
          span(class="hidden sm:inline") Trang trước
      div(class="flex items-center gap-1")
        - for (let i = 1; i <= objectPagination.totalPages; i++)
          if objectPagination.currentPage == i
            button(
              class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg shadow-sm border border-indigo-600"
              button-page=i
              type="button"
            ) #{i}
          else
            button(
              class="px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition-colors shadow-sm"
              button-page=i
              type="button"
            ) #{i}
      if objectPagination.currentPage < objectPagination.totalPages 
        button(
          class="page-link inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition-colors shadow-sm"
          button-page=(objectPagination.currentPage + 1)
          type="button"
          title="Trang tiếp"
        )
          span(class="hidden sm:inline") Kế tiếp
          i(data-lucide="chevron-right" class="w-4 h-4")
      else
        button(
          class="page-link inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-300 bg-slate-50 border border-slate-200 rounded-lg cursor-not-allowed"
          disabled
          type="button"
        )
          span(class="hidden sm:inline") Kế tiếp
          i(data-lucide="chevron-right" class="w-4 h-4")