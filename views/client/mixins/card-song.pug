//- mixin cardSong(song)
//- song: {title, cover, singer, createdAt, likes, slug, isFavorite, audio}
mixin cardSong(song)
  - var singerName = (song.singer_id && song.singer_id.fullname) ? song.singer_id.fullname : (song.singer || "Chưa cập nhật")
  - var songAvatar = song.avatar || song.cover || ""
  - var isFavorite = song.isFavorite || ((locals.favoriteSongIds || []).indexOf(song._id ? song._id.toString() : '') !== -1)
  div(class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 transition-all hover:bg-white/10" data-song-card)&attributes(attributes)
    div(class="relative aspect-square overflow-hidden")
      img(src=songAvatar alt=song.title class="w-full h-full object-cover")
      div(class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center")
        button(
          class="bg-indigo-500/90 hover:bg-indigo-500 text-white rounded-full p-3 transform scale-90 group-hover:scale-100 transition-all shadow-lg"
          onclick=`playSong('${(song.title || '').replace(/'/g, "\\'")}', '${singerName.replace(/'/g, "\\'")}', '${songAvatar}', '${song.audio || ''}')`
        )
          i(data-lucide="play" class="w-6 h-6 ml-1")
    div(class="p-4")
      a(href='/songs/' + song.slug)
        h3(class="font-semibold text-white truncate hover:text-indigo-400 transition-colors" title=song.title)= song.title
      p(class="text-sm text-slate-400 truncate mt-1")= singerName
      div(class="flex items-center justify-between mt-4")
        div(class="flex items-center gap-1.5 text-slate-400")
          button(type="button" data-favorite-song=song._id.toString() aria-pressed=isFavorite title="Yêu thích bài hát" class="transition-colors")
            i(data-lucide="heart" class=`w-4 h-4 ${isFavorite ? "fill-red-500 text-red-500" : ""}`)
          span(class="text-xs" data-song-likes)= song.like || 0
        button(class="text-slate-400 hover:text-white transition-colors" title="Add to favorites")
          i(data-lucide="more-horizontal" class="w-5 h-5")