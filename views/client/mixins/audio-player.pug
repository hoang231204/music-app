mixin audioPlayer()
  div#audio-player(
    class="fixed bottom-0 left-0 right-0 z-50 bg-[#0a0820]/95 backdrop-blur-xl border-t border-white/10 transform translate-y-full transition-transform duration-300"
  )&attributes(attributes)
    div(class="container mx-auto px-4 h-20 flex items-center justify-between gap-4")
      //- Left: Info
      div(class="flex items-center gap-3 w-1/3 min-w-0")
        img#player-cover(src="/images/default-song.png" alt="" class="w-14 h-14 rounded-lg object-cover shadow-lg bg-slate-800")
        div(class="truncate")
          h4#player-title(class="text-white font-semibold truncate") Chưa chọn bài hát
          p#player-artist(class="text-slate-400 text-sm truncate") ---
          
      //- Center: Controls
      div(class="flex-1 max-w-2xl flex flex-col items-center justify-center gap-1")
        div(class="flex items-center gap-6")
          button(type="button" title="Shuffle" class="text-slate-400 hover:text-white transition-colors")
            i(data-lucide="shuffle" class="w-4 h-4")
          button#player-prev-btn(type="button" title="Previous" class="text-slate-400 hover:text-white transition-colors")
            i(data-lucide="skip-back" class="w-5 h-5")
          button#player-play-btn(type="button" class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-105 transition-transform")
            i(data-lucide="play" class="w-5 h-5 ml-0.5")
          button#player-next-btn(type="button" title="Next" class="text-slate-400 hover:text-white transition-colors")
            i(data-lucide="skip-forward" class="w-5 h-5")
          button(type="button" title="Repeat" class="text-slate-400 hover:text-white transition-colors")
            i(data-lucide="repeat" class="w-4 h-4")
            
        div(class="w-full flex items-center gap-2 text-xs text-slate-400")
          span#player-current-time 00:00
          div(class="group relative flex-1 h-1.5 bg-white/10 rounded-full cursor-pointer")
            div#player-progress-bar(style="width: 0%" class="absolute left-0 top-0 h-full bg-indigo-500 rounded-full")
              div(class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-lg")
            input#player-progress(type="range" min="0" max="100" value="0" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer")
          span#player-duration 00:00
          
      //- Right: Volume & Extras
      div(class="flex items-center justify-end gap-4 w-1/3")
        i(data-lucide="mic-2" class="w-4 h-4 text-slate-400 hover:text-white cursor-pointer")
        div(class="flex items-center gap-2")
          button#player-volume-btn(type="button" class="text-slate-400 hover:text-white")
            i(data-lucide="volume-2" class="w-5 h-5")
          div(class="w-24 h-1.5 bg-white/10 rounded-full relative group")
            div#player-volume-bar(style="width: 70%" class="absolute left-0 top-0 h-full bg-indigo-500 rounded-full")
            input#player-volume(type="range" min="0" max="1" step="0.01" value="0.7" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer")
    audio#audio-element(class="hidden")