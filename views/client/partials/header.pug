- var user = locals.user
- var userName = user ? (user.fullname || user.username || 'Tài khoản') : ''

header(class="sticky top-0 z-50 bg-[#0a0820]/80 backdrop-blur-xl border-b border-white/10")
  div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8")
    div(class="flex items-center justify-between h-16")
      //- Left: Logo
      div(class="flex-shrink-0 flex items-center gap-2")
        img(src='/images/logo.svg' alt='Logo' class="h-8 w-8" onerror="this.src='https://cdn.iconscout.com/icon/free/png-256/music-1128-434479.png'")
        span(class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-pink-400") MusicApp

      //- Center: Nav links (hidden on mobile)
      nav(class="hidden md:flex items-center gap-6")
        a(href='/' class=`text-sm font-medium transition-colors hover:text-white ${locals.activeNav === 'home' ? 'text-white' : 'text-slate-300'}`) Trang chủ
        a(href='/topics' class=`text-sm font-medium transition-colors hover:text-white ${locals.activeNav === 'topics' ? 'text-white' : 'text-slate-300'}`) Chủ đề
        a(href='/songs' class=`text-sm font-medium transition-colors hover:text-white ${locals.activeNav === 'songs' ? 'text-white' : 'text-slate-300'}`) Bài hát
        a(href='/singers' class=`text-sm font-medium transition-colors hover:text-white ${locals.activeNav === 'singers' ? 'text-white' : 'text-slate-300'}`) Ca sĩ

      //- Right: Search + User
      div(class="flex items-center gap-4")
        //- Search
        div(class="relative hidden sm:block")
          i(data-lucide='search' class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400")
          input(type='text' placeholder='Tìm kiếm bài hát...' class="w-48 lg:w-64 bg-white/5 border border-white/10 rounded-full py-1.5 pl-9 pr-4 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all")

        //- User Area
        if user
          div(class="relative")
            button(type="button" class="flex items-center gap-2 p-1 rounded-full hover:bg-white/10 transition-colors" data-dropdown-toggle='userMenu')
              img(src=user.avatar || '/images/default-avatar.svg' alt=userName class="w-8 h-8 rounded-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(userName)")
              i(data-lucide='chevron-down' class="hidden sm:block w-4 h-4 text-slate-300")
            #userMenu(class="hidden absolute right-0 top-full mt-2 w-48 bg-[#1a1744] rounded-xl shadow-lg border border-white/10 py-1.5 z-50")
              div(class="px-4 py-2 border-b border-white/10")
                p(class="text-sm font-medium text-white truncate")= userName
              a(href='/profile' class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white transition-colors")
                i(data-lucide='user' class="w-4 h-4")
                | Hồ sơ
              form(action='/auth/logout' method='POST')
                button(type='submit' class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-400 hover:bg-white/5 hover:text-red-300 transition-colors")
                i(data-lucide='log-out' class="w-4 h-4")
                | Đăng xuất
        else
          div(class="flex items-center gap-3")
            a(href='/auth/login' class="text-sm font-medium text-slate-300 hover:text-white transition-colors") Đăng nhập
            a(href='/auth/register' class="text-sm font-medium bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-1.5 rounded-full transition-colors") Đăng ký

        //- Mobile menu toggle
        button#mobileMenuToggle(type='button' class="md:hidden p-2 rounded-lg text-slate-300 hover:bg-white/10 transition-colors")
          i(data-lucide='menu' class="w-5 h-5")

  //- Mobile menu dropdown
  #mobileMenu(class="hidden md:hidden bg-[#1a1744]/95 backdrop-blur-xl border-b border-white/10")
    div(class="px-4 pt-2 pb-4 space-y-1")
      div(class="mb-4 px-2")
        div(class="relative")
          i(data-lucide='search' class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400")
          input(type='text' placeholder='Tìm kiếm bài hát...' class="w-full bg-white/5 border border-white/10 rounded-full py-2 pl-9 pr-4 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500")
      a(href='/' class=`block px-3 py-2 rounded-lg text-base font-medium transition-colors ${locals.activeNav === 'home' ? 'bg-indigo-500/20 text-indigo-400' : 'text-slate-300 hover:bg-white/5 hover:text-white'}`) Trang chủ
      a(href='/topics' class=`block px-3 py-2 rounded-lg text-base font-medium transition-colors ${locals.activeNav === 'topics' ? 'bg-indigo-500/20 text-indigo-400' : 'text-slate-300 hover:bg-white/5 hover:text-white'}`) Chủ đề
      a(href='/songs' class=`block px-3 py-2 rounded-lg text-base font-medium transition-colors ${locals.activeNav === 'songs' ? 'bg-indigo-500/20 text-indigo-400' : 'text-slate-300 hover:bg-white/5 hover:text-white'}`) Bài hát
      a(href='/singers' class=`block px-3 py-2 rounded-lg text-base font-medium transition-colors ${locals.activeNav === 'singers' ? 'bg-indigo-500/20 text-indigo-400' : 'text-slate-300 hover:bg-white/5 hover:text-white'}`) Ca sĩ